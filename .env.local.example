# ─── Supabase ─────────────────────────────────────────────────────────────────
# Browser-visible (safe — enforces RLS via anon key)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Server-only (NEVER use VITE_ prefix — must not appear in the client bundle)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ─── How to get these values ──────────────────────────────────────────────────
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings → API
# 4. Copy:
#      "Project URL"          → VITE_SUPABASE_URL + SUPABASE_URL
#      "anon public" key      → VITE_SUPABASE_ANON_KEY
#      "service_role secret"  → SUPABASE_SERVICE_ROLE_KEY  (keep this secret!)
#
# ─── OAuth Configuration (Google Sign-In) ─────────────────────────────────────
# To enable Google OAuth:
# 1. Go to Supabase Dashboard → Authentication → Providers
# 2. Enable "Google" provider
# 3. Add your Google OAuth credentials (Client ID & Secret)
# 4. Add authorized redirect URL: https://<your-project-ref>.supabase.co/auth/v1/callback
# 5. For local development, also add: http://localhost:8080/auth-callback
#
# ─── Phone Authentication (SMS OTP) ───────────────────────────────────────────
# To enable phone auth:
# 1. Go to Supabase Dashboard → Authentication → Providers
# 2. Enable "Phone" provider
# 3. Configure SMS provider (Twilio, MessageBird, Vonage, etc.)
# 4. Add provider credentials
#
# ─── Vercel deployment ────────────────────────────────────────────────────────
# Add all 4 values in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# For SUPABASE_SERVICE_ROLE_KEY, set Environment = "Production, Preview" (NOT Browser)
